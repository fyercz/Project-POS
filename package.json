{
  "name": "pertashop-pos",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/fyercz/Project-POS.git"
  },
  "scripts": {
    "dev": "vite --port=3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port=3000 --strictPort",
    "clean": "rm -rf dist dist-electron",
    "lint": "tsc --noEmit",
    "electron:start": "electron electron/main.cjs",
    "build:exe": "vite build && electron-builder --win",
    "dev:lan": "vite --port=3000 --strictPort --host=0.0.0.0"
  },
  "build": {
    "appId": "com.pertashop.manajemen",
    "productName": "Sistem Laporan Pertashop",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  }
}
